# Copy to .env.local for local development. On Vercel, set the same names under
# Project Settings → Environment Variables. Never commit real values.

# --- Supabase (Project Settings → API Keys) --------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). Low risk (RLS protects data), but only the
# server uses it, so it has no NEXT_PUBLIC_ prefix.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# The secret key (sb_secret_...). Server only: used by the bank callback, sync and cron.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Public base URL of the app, no trailing slash. Used for email links and the bank redirect.
APP_URL=http://localhost:3000

# --- Enable Banking (https://enablebanking.com/cp/applications) ------------
# Application ID (the "kid" of the signing key).
ENABLE_BANKING_APP_ID=
# The private key generated with the application, as PEM. Either paste it with
# literal "\n" escapes on one line, or base64-encode the whole PEM file.
ENABLE_BANKING_PRIVATE_KEY=

# 32 random bytes, base64. Encrypts the bank session id at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Changing it makes stored sessions unreadable: every bank must then be renewed.
BANK_TOKEN_ENCRYPTION_KEY=

# --- Cron -------------------------------------------------------------------
# At least 16 characters. Vercel sends it as "Authorization: Bearer <secret>".
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Development only -------------------------------------------------------
# Adds "Demo Bank (not real)" with generated transactions. Leave unset in production.
ENABLE_DEMO_BANK=false
